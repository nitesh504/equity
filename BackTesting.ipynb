        print(f"Maximum Drawdown: ${metrics['max_drawdown']:,.2f} ({metrics['max_drawdown_pct']:.2f}%)")
        print(f"Recovery Factor: {metrics['recovery_factor']:.2f}")
        print(f"Calmar Ratio: {metrics['calmar_ratio']:.2f}")
