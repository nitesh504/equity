    def plot_results(self):
        """Plot enhanced backtest results including equity curve and drawdown"""
        if not self.trades:
            print("No trades to plot.")
            return
            
        # Create subplots
        fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(20, 12))
        
        # Plot 1: Price data with trade markers
        ax1.plot(self.data.index, self.data['Close'], alpha=0.7, linewidth=0.8, color='black', label='Price')
        
        # Mark trade entries
        for trade in self.trades:
            color = 'green' if trade.signal_type == 'BUY' else 'red'
            marker = '^' if trade.signal_type == 'BUY' else 'v'
            
            ax1.scatter(trade.entry_time, trade.entry_price, 
                       color=color, marker=marker, s=100, alpha=0.8)
            
            # Draw lines to exit points
            exit_color = 'green' if trade.gross_pnl > 0 else 'red'
            ax1.plot([trade.entry_time, trade.exit_time], 
                    [trade.entry_price, trade.exit_price], 
                    color=exit_color, alpha=0.6, linewidth=1)
            
            # Add SL and TP levels as horizontal lines
            ax1.axhline(y=trade.stop_loss, color='red', alpha=0.3, linestyle='--', linewidth=0.5)
            ax1.axhline(y=trade.take_profit, color='green', alpha=0.3, linestyle='--', linewidth=0.5)
        
        ax1.set_title(f'{self.symbol} - Price Chart with Trade Signals (Fixed SL=${self.sl_fixed}, TP=${self.tp_fixed})')
        ax1.set_ylabel('Price ($)')
        ax1.grid(True, alpha=0.3)
        ax1.legend(['Price', 'BUY Signal', 'SELL Signal'])
        
        # Plot 2: Equity Curve
        ax2.plot(self.equity_dates, self.equity_curve, color='blue', linewidth=2, label='Equity')
        ax2.fill_between(self.equity_dates, self.equity_curve, alpha=0.3, color='blue')
        ax2.axhline(y=self.initial_capital, color='black', linestyle='--', alpha=0.5, label='Initial Capital')
        ax2.set_title('Equity Curve')
        ax2.set_ylabel('Portfolio Value ($)')
        ax2.grid(True, alpha=0.3)
        ax2.legend()
        
        # Plot 3: Drawdown Curve (Absolute)
        if self.drawdown_curve:
            ax3.fill_between(self.equity_dates, self.drawdown_curve, alpha=0.5, color='red', label='Drawdown ($)')
            ax3.plot(self.equity_dates, self.drawdown_curve, color='red', linewidth=1)
            ax3.set_title('Absolute Drawdown')
            ax3.set_ylabel('Drawdown ($)')
            ax3.grid(True, alpha=0.3)
            ax3.legend()
            ax3.invert_yaxis()  # Invert y-axis so drawdowns appear as valleys
        
        # Plot 4: Drawdown Curve (Percentage)
        if self.drawdown_pct_curve:
            ax4.fill_between(self.equity_dates, self.drawdown_pct_curve, alpha=0.5, color='red', label='Drawdown (%)')
            ax4.plot(self.equity_dates, self.drawdown_pct_curve, color='red', linewidth=1)
            ax4.set_title('Percentage Drawdown')
            ax4.set_ylabel('Drawdown (%)')
            ax4.set_xlabel('Date')
            ax4.grid(True, alpha=0.3)
            ax4.legend()
            ax4.invert_yaxis()  # Invert y-axis so drawdowns appear as valleys
        
        plt.tight_layout()
        plt.show()
        
        # Additional plot: Trade Distribution and Fixed SL/TP Analysis
        fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(20, 10))
        
        # Trade P&L Distribution
        trade_pnls = [t.gross_pnl for t in self.trades]
        ax1.hist(trade_pnls, bins=20, alpha=0.7, color='blue', edgecolor='black')
        ax1.axvline(x=0, color='red', linestyle='--', alpha=0.7, label='Breakeven')
        ax1.axvline(x=self.tp_fixed * self.quantity, color='green', linestyle='--', alpha=0.7, label=f'Max Win (${self.tp_fixed * self.quantity})')
        ax1.axvline(x=-self.sl_fixed * self.quantity, color='red', linestyle='--', alpha=0.7, label=f'Max Loss ($-{self.sl_fixed * self.quantity})')
        ax1.set_title('Trade P&L Distribution')
        ax1.set_xlabel('Trade P&L ($)')
        ax1.set_ylabel('Frequency')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        
        # Cumulative P&L
        cumulative_pnl = np.cumsum(trade_pnls)
        trade_numbers = range(1, len(self.trades) + 1)
        ax2.plot(trade_numbers, cumulative_pnl, color='blue', linewidth=2)
        ax2.fill_between(trade_numbers, cumulative_pnl, alpha=0.3, color='blue')
        ax2.axhline(y=0, color='black', linestyle='--', alpha=0.5)
        ax2.set_title('Cumulative P&L by Trade Number')
        ax2.set_xlabel('Trade Number')
        ax2.set_ylabel('Cumulative P&L ($)')
        ax2.grid(True, alpha=0.3)
        
        # Exit Reason Distribution
        exit_reasons = [t.exit_reason for t in self.trades]
        reason_counts = pd.Series(exit_reasons).value_counts()
        colors = ['green' if 'Profit' in reason else 'red' if 'Loss' in reason else 'orange' for reason in reason_counts.index]
        ax3.pie(reason_counts.values, labels=reason_counts.index, autopct='%1.1f%%', colors=colors)
        ax3.set_title('Exit Reason Distribution')
        
        # Win Rate vs Time (Rolling)
        if len(self.trades) >= 10:
            window = min(20, len(self.trades) // 4)  # Use rolling window of 20 or quarter of trades
            rolling_wins = []
            rolling_trades = []
            
            for i in range(window, len(self.trades) + 1):
                recent_trades = self.trades[i-window:i]
                wins = len([t for t in recent_trades if t.gross_pnl > 0])
                rolling_wins.append((wins / window) * 100)
                rolling_trades.append(i)
            
            ax4.plot(rolling_trades, rolling_wins, color='blue', linewidth=2, label=f'Rolling Win Rate ({window} trades)')
            
            # Add breakeven win rate line
            breakeven_wr = self.sl_fixed / (self.sl_fixed + self.tp_fixed) * 100
            ax4.axhline(y=breakeven_wr, color='red', linestyle='--', alpha=0.7, label=f'Breakeven Win Rate ({breakeven_wr:.1f}%)')
            
            ax4.set_title(f'Rolling Win Rate (Window: {window} trades)')
            ax4.set_xlabel('Trade Number')
            ax4.set_ylabel('Win Rate (%)')
            ax4.legend()
            ax4.grid(True, alpha=0.3)
            ax4.set_ylim(0, 100)
        else:
            ax4.text(0.5, 0.5, 'Not enough trades\nfor rolling analysis', 
                    horizontalalignment='center', verticalalignment='center',
                    transform=ax4.transAxes, fontsize=12)
            ax4.set_title('Rolling Win Rate Analysis')
        
        plt.tight_layout()
        plt.show()

# Run the backtest
def main():
    print("Starting Enhanced Engulfing Strategy Backtest with Fixed SL/TP")
    print("Data Source: Yahoo Finance")
    
    # Initialize backtester with fixed SL/TP parameters
    backtester = EngulfingBacktester(
        symbol='JPM',  
        period_months=2,  # Will be limited by Yahoo's data availability
        sl_fixed=2,     # Fixed $1 stop loss
        tp_fixed=2,     # Fixed $2 take profit
        quantity=100      # 100 shares per trade
    )
    
    # Run backtest
    if backtester.run_backtest():
        # Generate report
        backtester.generate_report()
        
        # Plot results
        try:
            backtester.plot_results()
        except Exception as e:
            print(f"Could not generate plots: {e}")
            print("Report completed successfully without charts")
    else:
        print("Backtest failed - could not download data from Yahoo Finance")

if __name__ == "__main__":
    main()